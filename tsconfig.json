{
  "compilerOptions": {
    "target": "ESNext",
    "types": ["node"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "moduleDetection": "auto",
    "isolatedModules": true,
    "rootDir": "."
  },
  "include": ["src", "playground.ts", "playground"],
  "exclude": ["node_modules", "dist"]
}
