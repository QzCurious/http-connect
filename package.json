{
  "name": "@qzcurious/http-connect",
  "version": "0.0.8",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js"
    }
  },
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm run build",
    "format": "oxfmt",
    "lint": "oxlint playground",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@standard-schema/spec": "^1.1.0"
  },
  "devDependencies": {
    "@tanstack/query-core": "^5.108.4",
    "@types/node": "^26.6.10",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "rolldown-plugin-dts": "^0.30.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vscode-jsonrpc": "^10.0.1",
    "zod": "^4.6.7"
  },
  "packageManager": "pnpm@12.23.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QzCurious/http-connect.git"
  }
}
